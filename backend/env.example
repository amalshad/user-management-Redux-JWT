# Server
PORT=5000

# MongoDB connection string
# Local:  mongodb://127.0.0.1:27017/user-management-app
# Atlas:  mongodb+srv://<user>:<password>@<cluster-url>/user-management-app
MONGO_URI=

# Used to sign/verify JWTs — use a long random string
JWT_SECRET=

# Cloudinary (used for profile image uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
